# Токен бота из @BotFather. Пока он не задан, сервер работает в режиме
# разработки: вход по имени, доступ никто не проверяет.
TELEGRAM_BOT_TOKEN=

# Ссылка, которую бот присылает в чат. Для мини-приложения из BotFather это
# https://t.me/имя_бота/короткое_имя — такая ссылка открывается и из группы.
MINI_APP_URL=

# Чаты, участникам которых доступ открыт всегда. Обычно не нужно: бот
# запоминает чат сам, когда его туда добавляют. Узнать id — команда /id в чате.
TELEGRAM_ALLOWED_CHAT_IDS=

# Личные id, которым доступ открыт без чатов, — например, ваш собственный.
TELEGRAM_ADMIN_IDS=

# Опрос обновлений бота. Выключите (0) на втором процессе с тем же токеном:
# Telegram отдаёт обновления только одному получателю.
TELEGRAM_POLLING=1

# Необязательный HTTP(S) или SOCKS5-прокси только для Bot API, например:
# http://user:password@proxy.example.com:3128
# socks5://user:password@proxy.example.com:1080
TELEGRAM_PROXY_URL=

# Ключ подписи сессий. Без него после перезапуска все входят заново.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Сколько живёт сессия, секунд. По умолчанию 12 часов.
SESSION_TTL_SECONDS=43200

# Разрешить вход по имени без Telegram. По умолчанию включён,
# только пока не задан TELEGRAM_BOT_TOKEN.
ALLOW_DEV_AUTH=

# Временный тестовый вход по ключу (не менее 32 символов). Не включайте постоянно.
TEST_AUTH_KEY=

# Куда складывать колоды и список чатов.
DATA_DIR=./data

# Куда складывать загруженные картинки и звук.
MEDIA_DIR=./uploads

# Откуда разрешено обращаться к серверу: адреса фронта через запятую.
FRONTEND_ORIGIN=

PORT=3000

# Сколько крутится барабан «Поля чудес», мс. Допустимо от 500 до 30000,
# по умолчанию 4200. Значение уезжает клиентам вместе с состоянием вращения,
# поэтому анимация и момент остановки всегда совпадают.
FIELD_SPIN_DURATION_MS=4200
